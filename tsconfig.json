{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "prueba-contrato.ts", "prueba-ciclo.ts", "prueba-adaptador.ts", "prueba-servidor.ts", "demo.ts", "prueba-humo.ts"]
}
